{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "info": {
      "default": {
        "commands": [],
        "cli": [],
        "notes": []
      },
      "type": "object",
      "properties": {
        "commands": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "run": {
                "type": "string",
                "minLength": 1
              },
              "does": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["run", "does"]
          }
        },
        "cli": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "run": {
                "type": "string",
                "minLength": 1
              },
              "does": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["run", "does"]
          }
        },
        "notes": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "imports": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "repo": {
            "type": "string",
            "pattern": "^[\\w.-]+\\/[\\w.-]+$"
          },
          "source": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "ref": {
            "default": "HEAD",
            "type": "string",
            "minLength": 1
          },
          "path": {
            "default": "skills",
            "type": "string"
          },
          "skills": {
            "minItems": 1,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "maxLength": 64,
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    },
                    "as": {
                      "type": "string",
                      "maxLength": 64,
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    }
                  },
                  "required": ["name", "as"]
                }
              ]
            }
          },
          "setup": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": ["repo", "skills"]
      }
    }
  }
}
