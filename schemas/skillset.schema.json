{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "imports": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "repo": {
            "type": "string",
            "pattern": "^[\\w.-]+\\/[\\w.-]+$"
          },
          "ref": {
            "default": "HEAD",
            "type": "string",
            "minLength": 1
          },
          "path": {
            "default": "skills",
            "type": "string"
          },
          "skills": {
            "minItems": 1,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "maxLength": 64,
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    },
                    "as": {
                      "type": "string",
                      "maxLength": 64,
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    }
                  },
                  "required": ["name", "as"]
                }
              ]
            }
          }
        },
        "required": ["repo", "skills"]
      }
    }
  }
}
