{
  "$schema": "https://raw.githubusercontent.com/Satcomx00-x00/SkillSet/main/schemas/skillset.schema.json",
  "info": {
    "commands": [],
    "cli": [
      {
        "run": "export GITHUB_TOKEN=<token>",
        "does": "Lets the github MCP server act as you (fine-grained token, repo scope)"
      }
    ],
    "notes": [
      "Run /skillset-setup once per repo: it configures the issue tracker, triage labels and domain docs used by the mattpocock skills."
    ]
  },
  "imports": [
    {
      "repo": "mattpocock/skills",
      "ref": "main",
      "path": "skills/engineering",
      "skills": [
        "tdd",
        "diagnosing-bugs",
        "codebase-design",
        "code-review"
      ]
    },
    {
      "repo": "DietrichGebert/ponytail",
      "ref": "main",
      "path": "skills",
      "skills": [
        "ponytail",
        "ponytail-review"
      ],
      "source": "ponytail"
    }
  ]
}
